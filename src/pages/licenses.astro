---
// Open-source software shipped in the built site. Keep in sync with THIRD_PARTY_LICENSES.md.
import Base from '../layouts/Base.astro';
// The full LGPL text that covers LAME, kept once in the repo and rendered here verbatim.
import lgplText from '../../licenses/LGPL-2.0.txt?raw';
// The Apache-2.0 text that covers transformers.js.
import apacheText from '../../licenses/Apache-2.0.txt?raw';

const shipped = [
  {
    name: 'Mediabunny',
    version: '1.66.2',
    license: 'MPL-2.0',
    use: 'Reads and writes MP4, MOV, WebM and other media files, driving WebCodecs.',
    source: 'https://github.com/Vanilagy/mediabunny',
    licenseUrl: 'https://www.mozilla.org/en-US/MPL/2.0/',
  },
  {
    name: 'Mediabunny MP3 encoder (LAME)',
    version: '1.66.2',
    license: 'MPL-2.0 + LGPL-2.0',
    use: 'Encodes MP3 audio. It contains a WebAssembly build of the LAME 3.100 encoder (LGPL-2.0-or-later), used unmodified and loaded only for MP3 output.',
    source: 'https://github.com/Vanilagy/mediabunny/tree/v1.66.2/packages/mp3-encoder',
    licenseUrl: '#lgpl-2.0',
  },
  {
    name: 'Mediabunny FLAC encoder (libFLAC)',
    version: '1.66.2',
    license: 'MPL-2.0 + BSD-3-Clause',
    use: 'Encodes FLAC audio with a WebAssembly build of libFLAC, loaded only for FLAC output.',
    source: 'https://github.com/Vanilagy/mediabunny',
    licenseUrl: 'https://opensource.org/license/bsd-3-clause',
  },
  {
    name: 'gifenc',
    version: '1.0.3',
    license: 'MIT',
    use: 'Builds animated GIFs.',
    source: 'https://github.com/mattdesl/gifenc',
    licenseUrl: 'https://opensource.org/license/mit',
  },
  {
    name: 'Svelte',
    version: '5.59.1',
    license: 'MIT',
    use: 'The interactive tool interfaces.',
    source: 'https://github.com/sveltejs/svelte',
    licenseUrl: 'https://opensource.org/license/mit',
  },
  {
    name: 'Astro',
    version: '5.18.2',
    license: 'MIT',
    use: 'Builds the pages and loads the interactive parts.',
    source: 'https://github.com/withastro/astro',
    licenseUrl: 'https://opensource.org/license/mit',
  },
  {
    name: 'Transformers.js',
    version: '3.8.1',
    license: 'Apache-2.0',
    use: 'Runs the Whisper speech model for auto subtitles, loaded only by that tool.',
    source: 'https://github.com/huggingface/transformers.js/tree/3.8.1',
    licenseUrl: '#apache-2.0',
  },
  {
    name: 'Jinja (Hugging Face)',
    version: '0.5.13',
    license: 'MIT',
    use: 'Template engine bundled inside Transformers.js.',
    source: 'https://github.com/huggingface/huggingface.js/tree/main/packages/jinja',
    licenseUrl: 'https://opensource.org/license/mit',
  },
  {
    name: 'ONNX Runtime Web',
    version: '1.22.0-dev',
    license: 'MIT',
    use: 'The WebAssembly runtime that executes the speech model on your device.',
    source: 'https://github.com/microsoft/onnxruntime',
    licenseUrl: 'https://opensource.org/license/mit',
  },
];

const models = [
  { name: 'Whisper tiny', revision: 'ff4177021cc41f7db950912b73ea4fdf7d01d8e7', source: 'https://huggingface.co/onnx-community/whisper-tiny' },
  { name: 'Whisper base', revision: '27a07b4b52b3a4c5886134bb4320e93e1a4bbc7c', source: 'https://huggingface.co/onnx-community/whisper-base' },
  { name: 'Whisper small', revision: '36050c46d777d46dc4b5f43f6d90574fc38f8732', source: 'https://huggingface.co/onnx-community/whisper-small' },
];
---

<Base
  title="Licences | Framelab"
  description="The open-source software Framelab ships in your browser, with each licence and a link to its source code. Mediabunny is MPL-2.0, Transformers.js Apache-2.0."
>
  <article class="container prose">
    <h1>Licences</h1>
    <p>Framelab is © Arpan Mandal. All Rights Reserved. It is built with the following open-source software, which runs in your browser:</p>
    <table>
      <thead>
        <tr><th scope="col">Software</th><th scope="col">Licence</th><th scope="col">What it does here</th></tr>
      </thead>
      <tbody>
        {
          shipped.map((s) => (
            <tr>
              <td>
                <a href={s.source}>{s.name}</a> <span class="muted">{s.version}</span>
              </td>
              <td>
                <a href={s.licenseUrl}>{s.license}</a>
              </td>
              <td>{s.use}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>
      Mediabunny is used unmodified under the Mozilla Public License 2.0; its source code is available at the link above. Framelab ships no ffmpeg build
      and no GPL code.
    </p>

    <h2 id="lame">The MP3 encoder (LAME)</h2>
    <p>
      MP3 encoding uses <a href="https://lame.sourceforge.io/">LAME</a> 3.100, unmodified, compiled to WebAssembly by the Mediabunny MP3 encoder
      package. LAME is licensed under the GNU Library General Public License, version 2 or later; the full text is <a href="#lgpl-2.0">below</a>.
    </p>
    <p>Source code for the exact versions shipped:</p>
    <ul>
      <li>
        LAME 3.100: <a href="https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz">lame-3.100.tar.gz</a>
        (SHA-256 <code class="hash">ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e</code>)
      </li>
      <li>
        @mediabunny/mp3-encoder 1.66.2: <a href="https://registry.npmjs.org/@mediabunny/mp3-encoder/-/mp3-encoder-1.66.2.tgz">npm tarball</a>, and the
        <a href="https://github.com/Vanilagy/mediabunny/tree/v1.66.2/packages/mp3-encoder">v1.66.2 git tag</a> with the LAME bridge source and build
        steps
      </li>
    </ul>
    <p>
      <strong>The encoder is a separate, replaceable file.</strong> LAME and its bridge ship only in
      <code>/_astro/mediabunny-mp3-encoder-&lt;hash&gt;.js</code> (the hash changes with each build), which is loaded only when you choose MP3 output and
      holds no other Framelab code. You may replace that file with your own build of the encoder, including one made from a modified LAME.
    </p>

    <h2 id="speech">Speech recognition (auto subtitles)</h2>
    <p>
      Auto subtitles runs OpenAI's <a href="https://github.com/openai/whisper">Whisper</a> model in your browser with Transformers.js and ONNX Runtime
      Web. The Whisper weights were released by OpenAI under the <a href="https://github.com/openai/whisper/blob/main/LICENSE">MIT licence</a>; the
      ONNX conversions come from the onnx-community repositories below, at the pinned revisions. A model is downloaded from this site only after you
      confirm its size, and your audio never leaves your device.
    </p>
    <ul>
      {
        models.map((m) => (
          <li>
            <a href={m.source}>{m.name}</a>, revision <code class="hash">{m.revision}</code>
          </li>
        ))
      }
    </ul>
    <p>
      Transformers.js is used under the Apache License 2.0 (full text <a href="#apache-2.0">below</a>). One build-time change: the
      <code>https://</code> prefix is removed from the absolute URLs inside Transformers.js and ONNX Runtime Web (default hosts and documentation links),
      so the site names no third-party host; Framelab sets its own model and runtime locations at run time. No program logic is changed.
    </p>

    <h2 id="apache-2.0">Apache License, version 2.0</h2>
    <details>
      <summary>Show the full licence text</summary>
      <pre class="license-text" tabindex="0">{apacheText}</pre>
    </details>

    <h2 id="lgpl-2.0">GNU Library General Public License, version 2</h2>
    <details>
      <summary>Show the full licence text</summary>
      <pre class="license-text" tabindex="0">{lgplText}</pre>
    </details>
  </article>
</Base>

<style>
  .prose {
    max-width: 80ch;
    padding-top: var(--space-6);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
  }
  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .hash {
    overflow-wrap: anywhere;
  }
  .license-text {
    white-space: pre-wrap;
    font-size: 0.85rem;
    max-height: 60vh;
    overflow: auto;
    padding: var(--space-3);
    border: 1px solid var(--border);
  }
</style>
