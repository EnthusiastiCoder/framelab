---
// Base page shell: meta, skip link (first Tab stop), header, <main id="main">, footer.
import '../styles/global.css';
import { canonicalUrl, serializeJsonLd, SITE_NAME, type JsonLd } from '../lib/seo';
import NetworkProof from '../components/NetworkProof.astro';

interface Props {
  title: string;
  description: string;
  /** Structured data blocks for this page (each becomes one application/ld+json script). */
  jsonLd?: JsonLd[];
  /** Site path of the Open Graph image (1200x630 PNG under public/og/). */
  ogImage?: string;
  /** Pages that must not be indexed (404, offline). */
  noindex?: boolean;
  /** Show the network proof badge in the footer. Tool pages show it under the tool instead (one per page). */
  proofInFooter?: boolean;
}

const { title, description, jsonLd = [], ogImage = '/og/default.png', noindex = false, proofInFooter = true } = Astro.props;
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://framelab.pages.dev');
const canonical = canonicalUrl(site, path);
const ogImageUrl = new URL(ogImage, site).href;
const nav = [
  { href: '/', label: 'Tools' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4c3fd6" />
    {jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={serializeJsonLd(block)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/" aria-label="Framelab home">
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32"><rect x="3" y="6" width="26" height="20" rx="5" fill="currentColor" opacity="0.18"></rect><path d="M13 11.5v9l8-4.5z" fill="currentColor"></path></svg>
          <span>Framelab</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href || path === `${item.href}/` ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <div class="menu-panel">
            <button type="button" id="install-app" class="menu-item" hidden>Install app</button>
            <button type="button" id="theme-toggle" class="menu-item">Theme: System</button>
            <button type="button" class="menu-item" data-open-shortcuts>Keyboard shortcuts</button>
          </div>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        {proofInFooter && <NetworkProof />}
        <p>Everything runs in your browser. Your files never leave your device.</p>
        <p>
          <a href="/privacy">Privacy</a> · <a href="/licenses">Licences</a> · <a href="/about">About</a>
        </p>
        <p class="muted">© Arpan Mandal. All Rights Reserved.</p>
      </div>
    </footer>
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>
    <dialog id="shortcuts" class="sheet" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title">
      <h2 id="shortcuts-title">Keyboard shortcuts</h2>
      <dl class="keys">
        <dt><kbd>?</kbd></dt><dd>Show this list</dd>
        <dt><kbd>O</kbd></dt><dd>Choose a file (on a tool page)</dd>
        <dt><kbd>D</kbd></dt><dd>Switch the theme (system, light, dark)</dd>
        <dt><kbd>Enter</kbd></dt><dd>Open the file chooser when the drop area has focus</dd>
        <dt><kbd>Esc</kbd></dt><dd>Close this list</dd>
      </dl>
      <form method="dialog" class="sheet-actions">
        <a href="/about">About Framelab</a>
        <button type="submit" class="btn">Close</button>
      </form>
    </dialog>
    <script>
      import '../scripts/toasts';
      import '../scripts/theme';
      import '../scripts/shortcuts';
      import '../scripts/install';
      import '../scripts/sw-register';
      import '../scripts/network-proof';
      import '../scripts/drop-anywhere';
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .brand svg {
    color: var(--accent);
  }
  nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.9rem;
  }
  .footer-row {
    padding-block: var(--space-5);
  }
  .footer-row p {
    margin: 0 0 var(--space-2);
  }
  .footer-row :global(.proof) {
    margin-bottom: var(--space-3);
  }
  nav {
    margin-left: auto;
  }
  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 500;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 20;
    display: grid;
    min-width: 220px;
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .menu-item {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .menu-item:hover {
    background: var(--surface-2);
  }
  .menu-item[hidden] {
    display: none;
  }
  .toasts {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    left: var(--space-4);
    z-index: 50;
    display: grid;
    justify-items: end;
    gap: var(--space-2);
    pointer-events: none;
  }
  .toasts :global(.toast) {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 420px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .toasts :global(.toast-close) {
    min-width: 32px;
    min-height: 32px;
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: 1.3rem;
    cursor: pointer;
  }
  .sheet {
    width: min(100% - 2 * var(--space-4), 460px);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .sheet h2 {
    margin-top: 0;
  }
  .keys {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-5);
  }
  .keys dd {
    margin: 0;
  }
  kbd {
    display: inline-block;
    min-width: 2em;
    padding: 0 var(--space-2);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-family: var(--font-mono);
    text-align: center;
  }
  .sheet-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  @media (max-width: 520px) {
    nav {
      margin-left: 0;
      order: 3;
      width: 100%;
    }
    nav ul {
      gap: var(--space-4);
    }
    .header-row {
      padding-block: var(--space-2);
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
