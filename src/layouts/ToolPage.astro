---
// Tool landing page: heading and promise, the tool island above the fold (slot), then how-to, FAQ and related tools.
import Base from './Base.astro';
import NetworkProof from '../components/NetworkProof.astro';
import { toolBySlug } from '../lib/tools';
import { breadcrumbs, canonicalUrl, faqPage, howTo as howToLd, softwareApplication } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  h1: string;
  promise: string;
  howTo: string[];
  faq: Array<{ q: string; a: string }>;
  related: string[];
}

const { title, description, h1, promise, howTo, faq, related } = Astro.props;
const relatedTools = related.map((slug) => toolBySlug(slug)).filter((t) => t !== undefined);
const site = Astro.site ?? new URL('https://framelab.pages.dev');
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const slug = path.replace(/^\//, '');
const jsonLd = [
  softwareApplication({ name: `Framelab: ${h1}`, description, url: canonicalUrl(site, path) }),
  faqPage(faq),
  howToLd({ name: h1, steps: howTo }),
  breadcrumbs(site, [
    { name: 'Tools', path: '/' },
    { name: toolBySlug(slug)?.title ?? h1, path },
  ]),
];
---

<Base title={title} description={description} jsonLd={jsonLd} ogImage={`/og/${slug}.png`} proofInFooter={false}>
  <div class="container tool-page" data-tool-page>
    <header class="intro">
      <h1>{h1}</h1>
      <p class="promise">{promise}</p>
    </header>
    <slot />
    <div class="proof-row"><NetworkProof /></div>
    <section aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">{howTo.map((step) => <li>{step}</li>)}</ol>
    </section>
    <section class="prose">
      <slot name="body" />
    </section>
    <section aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </section>
    {
      relatedTools.length > 0 && (
        <section aria-labelledby="related">
          <h2 id="related">Related tools</h2>
          <ul class="related">
            {relatedTools.map((t) => (
              <li>
                <a href={`/${t.slug}`}>{t.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .tool-page {
    padding-top: var(--space-6);
  }
  .intro {
    margin-bottom: var(--space-5);
  }
  .promise {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .proof-row {
    margin-top: var(--space-4);
  }
  .steps {
    padding-left: var(--space-5);
  }
  .steps li {
    margin-bottom: var(--space-2);
  }
  .prose {
    max-width: 70ch;
    margin-top: var(--space-5);
  }
  details {
    border-bottom: 1px solid var(--border);
    padding: var(--space-3) 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }
</style>
